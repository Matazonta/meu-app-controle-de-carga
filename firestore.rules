rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: registrations
    // Fields:
    //   - driverName: string (required)
    //   - productType: string (required)
    //   - quantity: number (required)
    //   - origin: string (required)
    //   - destination: string (required)
    //   - timestamp: string (required)
    //
    // Collection: km_registrations
    // Fields:
    //   - date: string (required)
    //   - time: string (required)
    //   - vehicle: string (required)
    //   - driver: string (required)
    //   - start: string (required)
    //   - end: string (optional)
    //   - total: string (optional)
    //
    // Collection: alerts
    // Fields:
    //   - message: string (required)
    //   - timestamp: string (required)
    //   - type: string (required, 'cargo' | 'km')
    //
    // Collection: drivers
    // Fields:
    //   - name: string (required)
    //   - password: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isValidNumber(val) {
      return val is number;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidRegistration(data) {
      return data.keys().hasAll(['driverName', 'productType', 'quantity', 'origin', 'destination', 'timestamp']) &&
             isValidString(data.driverName, 1, 100) &&
             isValidString(data.productType, 1, 100) &&
             isValidNumber(data.quantity) &&
             isValidString(data.origin, 1, 100) &&
             isValidString(data.destination, 1, 100);
    }

    function isValidKMRegistration(data) {
      return data.keys().hasAll(['date', 'time', 'vehicle', 'driver', 'start']) &&
             isValidString(data.vehicle, 1, 20) &&
             isValidString(data.driver, 1, 100) &&
             isValidString(data.start, 1, 20);
    }

    function isValidAlert(data) {
      return data.keys().hasAll(['message', 'timestamp', 'type']) &&
             isValidString(data.message, 1, 500) &&
             data.type in ['cargo', 'km'];
    }

    function isValidDriver(data) {
      return data.keys().hasAll(['name']) &&
             isValidString(data.name, 1, 100);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /registrations/{regId} {
      allow read, write: if true;
    }

    match /km_registrations/{kmId} {
      allow read, write: if true;
    }

    match /alerts/{alertId} {
      allow read, write: if true;
    }

    match /drivers/{driverId} {
      allow read, write: if true;
    }
  }
}
